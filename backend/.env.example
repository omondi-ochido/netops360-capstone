# --- Supabase (server-side only: NEVER expose the service-role key to the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Flask ---
FLASK_ENV=development
FLASK_DEBUG=false
PORT=5050
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- API protection (interim shared key sent as the X-API-Key header). Leave empty ONLY in dev. ---
API_KEY=

# --- SSH (VyOS backups) ---
NETOPS_SSH_USERNAME=
NETOPS_SSH_PASSWORD=
SSH_TIMEOUT_SECONDS=15

# --- n8n ---
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
AUTOMATION_TIMEOUT_SECONDS=10
AUTOMATION_MAX_RETRIES=5
AUTOMATION_BACKOFF_SECONDS=30

# --- Monitoring ---
MONITORING_ENABLED=true
MONITORING_INTERVAL_SECONDS=30
MONITORING_WORKERS=8
PING_COUNT=3
PING_TIMEOUT_SECONDS=2
PARTIAL_LOSS_STATUS=Warning

# --- Backups ---
BACKUP_SCHEDULE_SECONDS=0
BACKUP_ON_CRITICAL_INCIDENT=false
