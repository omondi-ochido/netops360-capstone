    {
      "parameters": {
        "jsCode": "const p = $json.body ?? $json;\nconst headers = $json.headers ?? {};\nconst supplied = headers['x-netops-webhook-token'] || headers['X-NetOps-Webhook-Token'];\nconst expected = $env.NETOPS_WEBHOOK_SECRET || '';\nconst suppliedBytes = Buffer.from(typeof supplied === 'string' ? supplied : '');\nconst expectedBytes = Buffer.from(expected);\nif (!expected || suppliedBytes.length !== expectedBytes.length || !require('crypto').timingSafeEqual(suppliedBytes, expectedBytes)) throw new Error('Unauthorized incident webhook');\nconst events = ['incident.opened','incident.acknowledged','incident.resolved'];\nconst required = ['id','title','severity'];\nif (!events.includes(p.event_type)) throw new Error('Unsupported event_type');\nif (!p.incident || required.some(k => typeof p.incident[k] !== 'string' || !p.incident[k].trim())) throw new Error('Missing incident fields');\nif (!p.device || typeof p.device.hostname !== 'string' || !p.device.hostname || typeof p.device.ip_address !== 'string' || !p.device.ip_address || typeof p.device.site !== 'string' || !p.device.site) throw new Error('Missing device fields');\nif (typeof p.timestamp !== 'string' || Number.isNaN(Date.parse(p.timestamp)) || !p.automation_log_id) throw new Error('Missing or invalid timestamp or automation_log_id');\nif (!['critical','warning','info'].includes(p.incident.severity)) throw new Error('Unsupported severity');\nconst incident = p.incident, device = p.device;\nconst resolved = p.event_type === 'incident.resolved';\nconst priority = incident.severity === 'critical' ? 'HIGH PRIORITY' : incident.severity === 'warning' ? 'Warning' : 'Informational';\nconst message = `${resolved ? 'RECOVERY' : priority}: ${incident.title}\\nHost: ${device.hostname} (${device.ip_address})\\nSite: ${device.site}\\nSeverity: ${incident.severity}\\nMetric: ${incident.trigger_metric ?? p.rule?.metric ?? 'n/a'} = ${incident.trigger_value ?? 'n/a'}\\nDetected: ${p.timestamp}\\nStatus: ${incident.status}\\nReference: ${incident.id}`;\nconst channel = ($env.NETOPS_ALERT_CHANNEL || 'discord').toLowerCase();\nif (!['email','telegram','discord','slack','none'].includes(channel)) throw new Error('Unsupported NETOPS_ALERT_CHANNEL');\nif (incident.severity === 'info' && $env.NETOPS_NOTIFY_INFO !== 'true') return [{json:{...p, message, channel:'none', skipped:true}}];\nif (p.event_type === 'incident.acknowledged' && $env.NETOPS_NOTIFY_ACKNOWLEDGED !== 'true') return [{json:{...p, message, channel:'none', skipped:true}}];\nreturn [{json:{...p, message, channel, skipped:false}}];"
      },
