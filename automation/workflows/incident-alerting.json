    {
      "parameters": {
        "jsCode": "const input = $('Validate and Format').first().json;\nconst out = $json ?? {};\nconst statusCode = Number(out.statusCode ?? 0);\nconst body = out.body ?? out;\nconst httpAccepted = statusCode >= 200 && statusCode < 300;\nlet providerAccepted = !out.error;\nif (input.channel === 'telegram') providerAccepted = httpAccepted && body?.ok === true;\nelse if (input.channel === 'slack') providerAccepted = httpAccepted && (body === 'ok' || body?.ok === true);\nelse if (input.channel === 'discord') providerAccepted = httpAccepted;\nelse if (input.channel === 'email') providerAccepted = !out.error;\nconst skipped = input.skipped === true || input.channel === 'none';\nconst failed = !skipped && !providerAccepted;\nconst summary = skipped ? 'Notification skipped by configured policy' : failed ? `Notification provider failed (${input.channel})` : `Notification accepted by ${input.channel}`;\nconst callback = {automation_log_id:input.automation_log_id, execution_id:String($execution.id), status:failed?'failed':'success', response_summary:summary, error_details:failed?`${input.channel} notification was not accepted by the provider`:null};\nconst raw = JSON.stringify(callback);\nconst signature = 'sha256=' + require('crypto').createHmac('sha256', $env.NETOPS_WEBHOOK_SECRET).update(raw).digest('hex');\nreturn [{json:{callback_body:raw, callback_signature:signature}}];"
      },
