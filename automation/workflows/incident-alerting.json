    {
      "parameters": {
        "jsCode": "const p = $json;\nconst isSupported = ['router','switch'].includes(String(p.device?.device_type || '').toLowerCase());\nconst policyEnabled = (p.incident?.severity === 'critical' && $env.NETOPS_BACKUP_ON_CRITICAL === 'true') || (p.incident?.severity === 'warning' && $env.NETOPS_BACKUP_ON_WARNING === 'true');\nif ($env.NETOPS_BACKUP_EVENT_ENABLED !== 'true' || p.event_type !== 'incident.opened' || !p.device?.id || !p.incident?.id || !isSupported || !policyEnabled) return [];\nreturn [{json:p}];"
      },
