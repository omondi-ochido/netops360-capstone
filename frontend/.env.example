# Flask API origin. This value is public and safe to include in the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:5050

# Development only. Vite embeds this in client code, so every browser user can read it.
# Do not deploy a shared API key this way; use an authenticated reverse proxy or implement
# real user authentication before exposing protected write/backup/automation operations.
VITE_API_KEY=
